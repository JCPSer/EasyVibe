{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "EasyVibe 桌面壳默认能力：sidecar spawn + 更新器 + http origin 页面的 IPC 白名单",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/easyvibe-backend", "sidecar": true }]
    },
    "updater:default",
    "process:default"
  ]
}
