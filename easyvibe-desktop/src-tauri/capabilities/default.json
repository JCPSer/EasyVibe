{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "EasyVibe 桌面壳默认能力：仅允许 spawn 内嵌的 easyvibe-backend sidecar",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/easyvibe-backend", "sidecar": true }]
    }
  ]
}
