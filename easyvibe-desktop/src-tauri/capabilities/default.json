{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "EasyVibe 桌面壳默认能力：sidecar spawn + 更新器 + http origin 页面的 IPC 白名单 + 窗口控制（拖拽/最小化/缩放/关闭）",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "permissions": [
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/easyvibe-backend",
          "sidecar": true
        }
      ]
    },
    "updater:default",
    "process:default",
    "dialog:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-focused",
    "core:event:allow-listen",
    "notification:default"
  ]
}