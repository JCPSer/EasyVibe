{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "frontendDist": "../../easyvibe-renderer/dist",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/sync-desktop.ps1"
  },
  "bundle": {
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
