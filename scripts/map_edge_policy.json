{
  "version": 2,
  "rule": "build-time artifact hosting/embedding MUST NOT be a dependency edge",
  "must_drop": [
    {
      "from": "desktop-shell",
      "to": "console-ui",
      "reason": "tauri.conf resources/dist + frontendDist + sync-desktop.sh cp -R dist（打包期产物复制，非运行期符号引用）",
      "decision": "Q1-A: chosen over e20 because e20 is the c-arch-3 controlled host-capability adapter"
    },
    {
      "from": "server-api",
      "to": "console-ui",
      "reason": "build.rs include_dir!(dist) + router.rs ServeDir（编译期内嵌 / 运行期静态目录托管产物字节）"
    }
  ],
  "observe": [
    {
      "from": "server-api",
      "to": "map-toolchain",
      "reason": "build.rs reads scripts/assets.json（构建期配置清单，未闭合环）"
    },
    {
      "from": "desktop-shell",
      "to": "map-toolchain",
      "reason": "build.rs reads scripts/assets.json（构建期配置清单，未闭合环）"
    }
  ],
  "note": "架构事实的单一受版本控制落点（c-arch-12 / c-map-toolchain-2）。layers/modules 为规范（normative）网格：live map、emit_order.json、emit_order_modules.json、parts/*.files 与 fixture 均为其派生物；edges/gates/granularity 为守卫/CI/归纳期同源读取的棘轮与白名单。字段只写短名与 glob，禁点名受管资产（verify_assets.py --forbid-literals 自守）。",
  "layers": [
    {
      "id": "app-entry",
      "name": "应用装配层",
      "order": 0,
      "description": "桌面壳进程装配：托管后端 sidecar 与静态界面，管理窗口、单实例与自更新生命周期"
    },
    {
      "id": "presentation",
      "name": "交互呈现层",
      "order": 1,
      "description": "React 地图界面：画布可视化、对话与任务工作台、装配壳与设置分区"
    },
    {
      "id": "presentation-support",
      "name": "呈现支撑层",
      "order": 2,
      "description": "渲染进程地基：宿主能力端口、WS/REST 传输层、跨域纯逻辑契约与设计基元"
    },
    {
      "id": "application",
      "name": "应用服务层",
      "order": 3,
      "description": "axum REST/WS 边界、应用服务编排、启动装配、任务阶段状态机与外提领域模块（git/watcher 管线）"
    },
    {
      "id": "application-support",
      "name": "应用支撑层",
      "order": 4,
      "description": "application 层共享的事件出口与会话队列状态机，结构性切断服务层与任务引擎的环"
    },
    {
      "id": "domain",
      "name": "领域能力层",
      "order": 5,
      "description": "地图归纳/保鲜/增量合成与 agent 会话运行时两大领域能力"
    },
    {
      "id": "data",
      "name": "数据持久层",
      "order": 6,
      "description": "SQLite 迁移与按聚合域拆分的仓储，为地图/任务/会话/审批/设置提供状态持久化"
    },
    {
      "id": "foundation",
      "name": "基础契约层",
      "order": 7,
      "description": "零内部依赖的基础件：错误与密钥原语、事件名常量、REST/WS 契约类型"
    },
    {
      "id": "tooling",
      "name": "工具链层",
      "order": 8,
      "description": "地图归纳 CLI 参考实现与受管资产生成/校验脚本，只服务开发与打包，不进产品运行时"
    }
  ],
